{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "index.html",
          "checkout.html",
          "admin.html",
          "story.html",
          "success.html",
          "style.css",
          "app.js",
          "checkout.js",
          "admin.js",
          "assets/**",
          "data/**"
        ]
      }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/server.js" },
    { "src": "/(.*)", "dest": "/server.js" }
  ]
}
